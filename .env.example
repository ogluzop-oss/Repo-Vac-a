# Variables de entorno para despliegue SaaS (FASE SAAS-M). Copiar a .env (NO se versiona: está en .gitignore).
#
# ── Base de datos ───────────────────────────────────────────
# SEGURIDAD: el código ya NO usa una contraseña por defecto (antes 'admin123'). Si DB_PASSWORD falta,
# la app falla de forma explícita al conectar. En PRODUCCIÓN usa un usuario DEDICADO no-root con una
# contraseña fuerte y permisos SOLO sobre `smart_manager_db`, p. ej.:
#   CREATE USER 'smart_app'@'%' IDENTIFIED BY '<contraseña-fuerte>';
#   GRANT ALL PRIVILEGES ON smart_manager_db.* TO 'smart_app'@'%';  FLUSH PRIVILEGES;
DB_HOST=127.0.0.1
DB_USER=smart_app
DB_PASSWORD=CAMBIA-esta-contrasena
DB_NAME=smart_manager_db
DB_PORT=3306
API_CORS_ORIGINS=https://app.tudominio.com
SMART_MANAGER_JWT_SECRET=genera-un-secreto-fuerte
# Almacenamiento externo opcional (object storage) para documentos/backups por tenant.
SM_OBJECT_STORAGE_URL=

# ── ROL DEL TERMINAL ────────────────────────────────────────
# Define qué interfaz arranca ESTA máquina (no hay botón para cambiarla en caliente):
#   TERMINAL_ROL=TPV        → cajero (ERP + TPV tradicional). Es el valor por defecto.
#   TERMINAL_ROL=AUTOCOBRO  → kiosco de autoservicio (pantalla completa, sin login).
# Sinónimos aceptados: CAJERO/TRADICIONAL (=TPV); SELF_CHECKOUT/KIOSCO/TOTEM (=AUTOCOBRO).
# TERMINAL_ROL=TPV
# Alternativa: identificar la máquina por su código de terminal y leer el rol de ioc_terminales.
# TERMINAL_CODIGO=AUTO-01
# ID de caja para el autocobro (permite AUTO-01, AUTO-02…). Por defecto AUTO-01.
# TERMINAL_CAJA=AUTO-01

# ── Correo corporativo · Gmail API (OAuth) ──────────────────
# Opcional. Necesario para ENVIAR correo vía API de Gmail con OAuth y, además, para LEER la
# bandeja real de Gmail y los eventos de Google Calendar (módulo Correo → Bandeja / Planificar
# Citas → Sincronizar con Google) — ver GOOGLE_SCOPES en src/services/correo/servicio.py.
# IMPORTANTE: si una cuenta de Google ya estaba conectada ANTES de que GOOGLE_SCOPES incluyera
# los scopes de lectura (gmail.readonly/calendar.readonly), hay que pulsar "CONECTAR (OAuth)" de
# nuevo sobre ese buzón para reconsentir los permisos nuevos; si no, la sincronización fallará con
# un 403 de Google (mensaje honesto en la UI pidiendo reconectar, nunca un traceback).
#
# CENTRALIZADO POR DEFECTO: la app ya trae un client OAuth de Google ÚNICO y empaquetado
# (assets/google_oauth_client.json, un solo proyecto de Google Cloud de Smart Manager) — NINGÚN
# cliente/instalación necesita ya crear su propio proyecto de Google Cloud ni descargar un
# client-secret. Las variables de abajo y el secret manager siguen existiendo como OVERRIDE
# explícito del operador (p. ej. un despliegue white-label con marca/cliente OAuth propios).
# Orden de resolución del client OAuth: 1) estas variables, 2) secret manager,
# 3) client OAuth centralizado bundled (assets/google_oauth_client.json), 4) GOOGLE_OAUTH_CLIENT_FILE,
# 5) documentos/google_oauth_client.json (los dos últimos: fallback heredado, instalaciones antiguas).
# RECOMENDADO: no tocar nada aquí (se usa el client centralizado); solo rellenar estas variables
# (o un secret manager) si este despliegue necesita su PROPIO client OAuth de Google.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Fallback heredado (ruta a un client_secret.json de Google Cloud):
# GOOGLE_OAUTH_CLIENT_FILE=
# Backend de secretos (fernet por defecto; 'vault' = punto de extensión KMS/Vault):
# SM_SECRET_BACKEND=fernet

# ── SOMA · IA conversacional y voz ──────────────────────────
# Clave de Anthropic para el motor LLM de SOMA (tool-use real contra el servidor MCP interno).
# Sin esta clave, SOMA sigue funcionando con su motor de reglas de siempre (degradación automática).
# ANTHROPIC_API_KEY=
# Modelo del motor conversacional de SOMA (por defecto claude-haiku-4-5-20251001 si se omite):
# SMART_MANAGER_SOMA_MODEL=
# Voz clonada de SOMA en ElevenLabs (opcional). Sin estas dos variables, SOMA habla con
# Microsoft Edge TTS (es-ES-ElviraNeural) como hasta ahora. Con ambas configuradas, usa la
# voz clonada vía REST y degrada automáticamente a Edge TTS si la API falla en un turno.
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=
# Modelo de ElevenLabs (por defecto eleven_multilingual_v2 si se omite):
# ELEVENLABS_MODEL_ID=
