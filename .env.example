# Variables de entorno para despliegue SaaS (FASE SAAS-M). Copiar a .env (NO se versiona: está en .gitignore).
#
# ── Base de datos ───────────────────────────────────────────
# SEGURIDAD: el código ya NO usa una contraseña por defecto (antes 'admin123'). Si DB_PASSWORD falta,
# la app falla de forma explícita al conectar. En PRODUCCIÓN usa un usuario DEDICADO no-root con una
# contraseña fuerte y permisos SOLO sobre `smart_manager_db`, p. ej.:
#   CREATE USER 'smart_app'@'%' IDENTIFIED BY '<contraseña-fuerte>';
#   GRANT ALL PRIVILEGES ON smart_manager_db.* TO 'smart_app'@'%';  FLUSH PRIVILEGES;
DB_HOST=127.0.0.1
DB_USER=smart_app
DB_PASSWORD=CAMBIA-esta-contrasena
DB_NAME=smart_manager_db
DB_PORT=3306
API_CORS_ORIGINS=https://app.tudominio.com
SMART_MANAGER_JWT_SECRET=genera-un-secreto-fuerte
# Almacenamiento externo opcional (object storage) para documentos/backups por tenant.
SM_OBJECT_STORAGE_URL=

# ── ROL DEL TERMINAL ────────────────────────────────────────
# Define qué interfaz arranca ESTA máquina (no hay botón para cambiarla en caliente):
#   TERMINAL_ROL=TPV        → cajero (ERP + TPV tradicional). Es el valor por defecto.
#   TERMINAL_ROL=AUTOCOBRO  → kiosco de autoservicio (pantalla completa, sin login).
# Sinónimos aceptados: CAJERO/TRADICIONAL (=TPV); SELF_CHECKOUT/KIOSCO/TOTEM (=AUTOCOBRO).
# TERMINAL_ROL=TPV
# Alternativa: identificar la máquina por su código de terminal y leer el rol de ioc_terminales.
# TERMINAL_CODIGO=AUTO-01
# ID de caja para el autocobro (permite AUTO-01, AUTO-02…). Por defecto AUTO-01.
# TERMINAL_CAJA=AUTO-01

# ── Correo corporativo · Gmail API (OAuth) ──────────────────
# Opcional. Solo necesario para ENVIAR correo vía API de Gmail con OAuth (la
# recepción usa IMAP y el envío también admite SMTP con contraseña de aplicación).
# Orden de resolución del client OAuth: 1) estas variables, 2) secret manager,
# 3) GOOGLE_OAUTH_CLIENT_FILE, 4) documentos/google_oauth_client.json (fallback heredado).
# RECOMENDADO: usar estas variables (o un secret manager) en vez de un JSON en disco.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Fallback heredado (ruta a un client_secret.json de Google Cloud):
# GOOGLE_OAUTH_CLIENT_FILE=
# Backend de secretos (fernet por defecto; 'vault' = punto de extensión KMS/Vault):
# SM_SECRET_BACKEND=fernet
