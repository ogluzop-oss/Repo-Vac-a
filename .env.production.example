# ─────────────────────────────────────────────────────────────────────────────
# Smart Manager AI · Plantilla de entorno PRODUCCIÓN (Fase 2 SaaS deployment).
# Copiar a `.env.production` y rellenar EXCLUSIVAMENTE desde el secret store seguro.
# NO poner secretos reales aquí ni en Git. Todos los valores <...> son [EXTERNO — PROVISIONADO REAL].
# ─────────────────────────────────────────────────────────────────────────────
ENVIRONMENT=production

# Base de datos productiva (con backups + replicación gestionadas por el proveedor)
DB_HOST=<host-mariadb-produccion>          # [EXTERNO]
DB_USER=<usuario-produccion-minimos-privilegios>
DB_PASSWORD=<desde-secret-store>           # [EXTERNO] NUNCA en Git; inyectar en runtime
DB_NAME=smart_manager_prod
DB_PORT=3306

# API / seguridad
API_CORS_ORIGINS=https://app.tudominio.com,https://admin.tudominio.com
SMART_MANAGER_JWT_SECRET=<desde-secret-store>          # [EXTERNO] rotable; único de producción

# Almacenamiento externo (object storage privado para documentos/backups por tenant)
SM_OBJECT_STORAGE_URL=<url-bucket-produccion-privado>  # [EXTERNO — REQUIERE PROVISIONADO REAL]

# Secretos: 'vault' recomendado en producción (KMS/Vault); 'fernet' como fallback local
SM_SECRET_BACKEND=vault                     # [EXTERNO] requiere KMS/Vault

# Almacenamiento de documentos/backups: 'local' (volumen Docker persistente del VPS) por defecto y
# única opción soportada en esta fase — explícito aquí para que quede claro en el entorno real.
STORAGE_BACKEND=local

# Jobs asíncronos (facturación recurrente, recordatorios, verificación de backups...): el scheduler
# propio de la app (`src/services/scheduler.py`, un hilo en el mismo proceso del backend), sin cola
# externa — JOB_QUEUE_BACKEND=local es el único backend soportado en esta fase (es también el valor
# por defecto si se omite esta variable).
JOB_QUEUE_BACKEND=local

# Multi-región (activación real = [EXTERNO]: nodos/regiones desplegados)
PRIMARY_REGION=eu-west
SECONDARY_REGION=<region-secundaria>        # [EXTERNO]
FAILOVER_REGION=<region-failover>           # [EXTERNO]

# CDN / DNS / TLS (configuración real = [EXTERNO])
CDN_DOMAIN=<cdn.tudominio.com>              # [EXTERNO]

# OAuth de terceros (credenciales de app de PRODUCCIÓN, desde secret store)
GOOGLE_OAUTH_CLIENT_ID=<desde-secret-store>
GOOGLE_OAUTH_CLIENT_SECRET=<desde-secret-store>

# Sitio oficial (smartmanager-app.com, `src/backend/sitio_oficial.py`) + servidor central de
# licencias (`src/backend_central/`, servicio `backend_central` de docker-compose.prod.yml).
# CENTRAL_INTERNAL_SECRET: mismo valor EXACTO en `backend` y `backend_central` (puente interno,
# nunca expuesto); generar con `openssl rand -hex 32`. [EXTERNO — generar en el servidor]
CENTRAL_INTERNAL_SECRET=<desde-secret-store>
# Cuenta de Stripe (modo live) — Checkout de los 3 planes (Básico/Plus/Pro son todos de pago). Sin
# estas 4, el sitio degrada honestamente (nunca finge un cobro) en vez de dejar contratar un plan.
STRIPE_SECRET_KEY=<desde-secret-store>             # [EXTERNO] sk_live_...
STRIPE_PRICE_ID_BASIC=<desde-stripe-dashboard>     # [EXTERNO] price_... (recurrente, mensual, 29€)
STRIPE_PRICE_ID_PLUS=<desde-stripe-dashboard>      # [EXTERNO] price_... (recurrente, mensual, 49€)
STRIPE_PRICE_ID_PRO=<desde-stripe-dashboard>       # [EXTERNO] price_... (recurrente, mensual, 149€)
# Webhook de Stripe para renovaciones (`backend_central/rutas_stripe.py`) — el `whsec_...` que
# Stripe entrega al configurar el endpoint https://admin.smartmanager-app.com/central/stripe/webhook
STRIPE_WEBHOOK_SECRET_SAAS=<desde-stripe-dashboard>  # [EXTERNO]
# Email del código de activación al darse de alta en el sitio oficial (SMTP directo). Opcional: sin
# ello, el código se sigue mostrando en pantalla tras el alta, solo no se reenvía por email.
SMTP_HOST=<smtp.proveedor.com>                     # [EXTERNO]
SMTP_PORT=587
SMTP_USER=<usuario-smtp>                           # [EXTERNO]
SMTP_PASSWORD=<desde-secret-store>                 # [EXTERNO]
SMTP_FROM=noreply@smartmanager-app.com

# Portales Smart Suppliers — PORTAL_PROVEEDOR_URL / PORTAL_EMPRESA_URL / PORTAL_EMPLEADO_URL.
# OJO: este backend (contenedor) NO LEE estas variables — no tienen efecto aquí. Las consume el
# código de ESCRITORIO (`src/gui/compras_gestion.py`, `src/services/compras/invitaciones.py`,
# `src/gui/tpv.py`), que corre en el PROCESO de cada equipo cliente, no en este servidor. Se listan
# aquí solo como referencia de qué valores debe tener cada `.env` de escritorio (ver `.env.example`)
# para que apunten al dominio público real en vez de a `http://localhost:8090/...` (degradación por
# defecto, solo válida en desarrollo local). PORTAL_EMPLEADO_URL además requiere que
# SMART_MANAGER_JWT_SECRET sea IDÉNTICO en ese escritorio y en este servidor (el token se verifica
# aquí contra ese mismo secreto).
#   PORTAL_PROVEEDOR_URL=https://admin.tudominio.com/portal/proveedor
#   PORTAL_EMPRESA_URL=https://admin.tudominio.com/portal/empresa
#   PORTAL_EMPLEADO_URL=https://admin.tudominio.com/portal/empleado

# gunicorn: worker asíncrono obligatorio para soportar las conexiones SSE (tiempo real) detrás de
# cualquier proxy inverso (Caddy/Nginx/Traefik) sin bloquear el resto de peticiones.
GUNICORN_WORKER_CLASS=gevent
