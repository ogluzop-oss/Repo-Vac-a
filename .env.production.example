# ─────────────────────────────────────────────────────────────────────────────
# Smart Manager AI · Plantilla de entorno PRODUCCIÓN (Fase 2 SaaS deployment).
# Copiar a `.env.production` y rellenar EXCLUSIVAMENTE desde el secret store seguro.
# NO poner secretos reales aquí ni en Git. Todos los valores <...> son [EXTERNO — PROVISIONADO REAL].
# ─────────────────────────────────────────────────────────────────────────────
ENVIRONMENT=production

# Base de datos productiva (con backups + replicación gestionadas por el proveedor)
DB_HOST=<host-mariadb-produccion>          # [EXTERNO]
DB_USER=<usuario-produccion-minimos-privilegios>
DB_PASSWORD=<desde-secret-store>           # [EXTERNO] NUNCA en Git; inyectar en runtime
DB_NAME=smart_manager_prod
DB_PORT=3306

# API / seguridad
API_CORS_ORIGINS=https://app.tudominio.com,https://admin.tudominio.com
SMART_MANAGER_JWT_SECRET=<desde-secret-store>          # [EXTERNO] rotable; único de producción

# Almacenamiento externo (object storage privado para documentos/backups por tenant)
SM_OBJECT_STORAGE_URL=<url-bucket-produccion-privado>  # [EXTERNO — REQUIERE PROVISIONADO REAL]

# Secretos: 'vault' recomendado en producción (KMS/Vault); 'fernet' como fallback local
SM_SECRET_BACKEND=vault                     # [EXTERNO] requiere KMS/Vault

# Multi-región (activación real = [EXTERNO]: nodos/regiones desplegados)
PRIMARY_REGION=eu-west
SECONDARY_REGION=<region-secundaria>        # [EXTERNO]
FAILOVER_REGION=<region-failover>           # [EXTERNO]

# CDN / DNS / TLS (configuración real = [EXTERNO])
CDN_DOMAIN=<cdn.tudominio.com>              # [EXTERNO]

# OAuth de terceros (credenciales de app de PRODUCCIÓN, desde secret store)
GOOGLE_OAUTH_CLIENT_ID=<desde-secret-store>
GOOGLE_OAUTH_CLIENT_SECRET=<desde-secret-store>

# ─────────────────────────────────────────────────────────────────────────────
# AWS PRODUCTION-READY (Fase 10). Sólo NOMBRES/config — NUNCA claves. Credenciales por IAM Role/Task Role
# (jamás AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY en Git). Todos los valores <...> son [EXTERNO].
# ─────────────────────────────────────────────────────────────────────────────
# Interruptor MAESTRO de intención AWS. false por defecto → la app opera en modo local (los backends por
# STORAGE_BACKEND/SM_SECRET_BACKEND/JOB_QUEUE_BACKEND deciden en la práctica). Se pone true cuando la infra AWS
# esté desplegada y se quieran activar los backends AWS.
AWS_ENABLED=false
AWS_REGION=<region-aws>                        # [EXTERNO] p.ej. eu-west-1

# Storage → Amazon S3 (backend por configuración; 'local' en DEV, 's3' en STAGING/PROD)
STORAGE_BACKEND=s3                             # local | s3
S3_BUCKET=<bucket-privado-produccion>          # [EXTERNO] Block Public Access ON
S3_PREFIX=                                     # prefijo opcional dentro del bucket
S3_SSE=aws:kms                                 # AES256 | aws:kms (cifrado en reposo)
S3_KMS_KEY_ID=<arn-cmk-kms>                    # [EXTERNO] si S3_SSE=aws:kms
# AWS_ENDPOINT_URL=                            # sólo para pruebas locales tipo MinIO/localstack

# Secretos → AWS Secrets Manager (interfaz única; no duplica el sistema de secretos)
SM_SECRET_BACKEND=aws_secrets_manager          # fernet | vault | aws_secrets_manager
# Prefijo por ENTORNO para el nombre de los secretos (evita colisión dev/staging/prod en una misma cuenta y
# casa con la IaC: module secrets → `${project}-${environment}/<CLAVE>`). Debe TERMINAR en '/'.
SM_SECRET_PREFIX=smart-manager-production/      # [EXTERNO] p.ej. smart-manager-<env>/ ; vacío = nombre desnudo

# Jobs asíncronos → Amazon SQS (separado de la distribución de eventos)
JOB_QUEUE_BACKEND=sqs                          # local | sqs
SQS_QUEUE_URL=<url-cola-sqs>                    # [EXTERNO]
SQS_DLQ_URL=<url-cola-dlq>                      # [EXTERNO] dead-letter queue (poison messages)
SQS_VISIBILITY_TIMEOUT=300                      # segundos ≥ duración máx. de un forecast Prophet
SQS_MAX_RECEIVE_COUNT=5                         # reentregas antes de mover a la DLQ
JOB_MAX_ATTEMPTS=5                              # reintentos a nivel de worker (idempotente)
JOB_IDEMPOTENCY_BACKEND=db                      # memory | db (db = dedup entre workers)
# INSTANCE_ID lo inyecta ECS por tarea; si falta, se genera uno único por proceso (distribución SSE)

# Distribución de eventos SSE multi-instancia → broker (ElastiCache Redis). SÓLO si se escala SSE.
REALTIME_BROKER_URL=<redis://host:6379>        # [EXTERNO] reservado a distribución realtime (no a jobs)

# gunicorn (SSE): worker asíncrono obligatorio detrás de ALB/CloudFront
GUNICORN_WORKER_CLASS=gevent
