# ─────────────────────────────────────────────────────────────────────────────
# Smart Manager AI · Plantilla de entorno STAGING (Fase 2 SaaS deployment).
# Copiar a `.env.staging` y rellenar con los valores de STAGING. NO contiene secretos reales.
# NUNCA reutilizar credenciales/datos de PRODUCCIÓN en staging.
# ─────────────────────────────────────────────────────────────────────────────
ENVIRONMENT=staging

# Base de datos (instancia de STAGING, distinta de producción)
DB_HOST=<host-mariadb-staging>
DB_USER=<usuario-staging>
DB_PASSWORD=<contraseña-staging>          # [EXTERNO] proveer en el secret store, no en Git
DB_NAME=smart_manager_staging
DB_PORT=3306

# API / seguridad
API_CORS_ORIGINS=https://staging.tudominio.com
SMART_MANAGER_JWT_SECRET=<secreto-jwt-staging-fuerte>   # generar único por entorno; nunca compartir con prod

# Almacenamiento externo (object storage) para documentos/backups por tenant
SM_OBJECT_STORAGE_URL=<url-bucket-staging>              # [EXTERNO — REQUIERE PROVISIONADO REAL]

# Backend de secretos: 'fernet' (por defecto) o 'vault' (KMS/Vault en staging/prod)
SM_SECRET_BACKEND=fernet

# Multi-región (preparado; regiones reales = [EXTERNO])
PRIMARY_REGION=eu-west
SECONDARY_REGION=
FAILOVER_REGION=

# OAuth de terceros (opcional; credenciales de app de STAGING)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
