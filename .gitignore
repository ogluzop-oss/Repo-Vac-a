# ============================================================
# Smart Manager AI — .gitignore
# ============================================================

# ── Python ──────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
# spec de PyInstaller del proyecto: SÍ se versiona
*.spec
!SmartManagerAI.spec

# ── Entornos virtuales ──────────────────────────────────────
.venv/
venv/
env/
ENV/

# ── Configuración sensible / local ──────────────────────────
.env
*.env
!.env.example

# ── Editores / IDE ──────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo

# ── Sistema operativo ───────────────────────────────────────
Thumbs.db
Desktop.ini
.DS_Store

# ── Salidas en tiempo de ejecución (documentos/) ────────────
# Carpeta de salida: PDFs, etiquetas, tickets, informes, QR, cachés
# y estado local. NO debe versionarse (es datos generados).
documentos/*
!documentos/.gitkeep
# Misma salida generada si aparece bajo src/ (p. ej. cierres Z lanzados desde src/).
src/documentos/

# Caché de traducción IA y ajustes locales (por si se generan fuera)
ai_translate_cache.json
app_settings.json
# Edición elegida en el onboarding (per-install): NO versionar; cada instalación decide su tipo de comercio.
config_edicion.json
config_onboarding.json
# Identidad de instalación para el servidor central de licencias (installation_id + credenciales
# de activación) — per-install, nunca versionar.
config_instalacion.json

# ── Logs ────────────────────────────────────────────────────
*.log
logs/

# Artefactos de cobertura y temporales (UX-TPV-01 cleanup)
.coverage
.coverage.*
_tmp_*.txt

# Credenciales OAuth (nunca versionar)
src/gui/client_secrets.json
client_secret*.json
# Cliente OAuth de Google centralizado de la app (assets/google_oauth_client.json): repo PÚBLICO
# (github.com/ogluzop-oss/Repo-Vac-a, confirmado vía API sin autenticar) — nunca se comitea aquí.
# Cada despliegue/operador coloca su propia copia local del fichero real, o usa las variables de
# entorno GOOGLE_OAUTH_CLIENT_ID/SECRET (o el secret manager) como alternativa sin fichero — ver
# `_resolver_client_oauth` en src/services/correo/servicio.py.
assets/google_oauth_client.json
