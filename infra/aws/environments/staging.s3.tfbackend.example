# Backend de estado remoto — STAGING. Copiar a `staging.s3.tfbackend` y rellenar NOMBRES reales (no secretos).
# key ÚNICA por entorno → aislamiento total del tfstate.
# Uso: terraform init -reconfigure -backend-config=environments/staging.s3.tfbackend
bucket         = "<bucket-estado-terraform>"      # [EXTERNO]
key            = "smart-manager/staging/terraform.tfstate"
region         = "<aws-region>"                   # [EXTERNO]
dynamodb_table = "<tabla-lock-terraform>"         # [EXTERNO]
encrypt        = true
